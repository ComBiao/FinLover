MONGODB_URI=mongodb://127.0.0.1:27017/finlover?replicaSet=rs0&directConnection=true
JWT_SECRET=
BCRYPT_SALT_ROUNDS=10
APPLICATION_TIMEZONE=Asia/Bangkok
# Exact production/custom origins. Preview origins also use platform deployment metadata.
PUBLIC_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CRON_SECRET=
# Epic 7 shared wallets: the frontend ships with an in-memory mock layer for endpoints the backend has not built yet.
# On by default; set to false once the real API is live (see src/features/wallets/shared/mockFlag.ts).
NEXT_PUBLIC_SHARED_WALLET_MOCKS=true
